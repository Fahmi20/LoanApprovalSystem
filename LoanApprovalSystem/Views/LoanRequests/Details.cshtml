@model LoanApprovalSystem.Models.LoanRequest

@{
    ViewData["Title"] = "Loan Request Details";
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="mb-4">
                <h2 class="fw-bold mb-1">Loan Request Details</h2>
                <p class="text-muted mb-0">
                    Detail informasi pengajuan peminjaman dan status approval.
                </p>
            </div>

            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div>
                            <h4 class="fw-bold mb-1">
                                @Model.Title
                            </h4>

                            <p class="text-muted mb-0">
                                Nomor Peminjaman:
                                <span class="fw-semibold">@Model.LoanNumber</span>
                            </p>
                        </div>

                        <div>
                            @if (Model.Status == "Pending Manager")
                            {
                                <span class="badge bg-warning text-dark fs-6">
                                    Menunggu Manager
                                </span>
                            }
                            else if (Model.Status == "Pending Direktur")
                            {
                                <span class="badge bg-info text-dark fs-6">
                                    Menunggu Direktur
                                </span>
                            }
                            else if (Model.Status == "Approved")
                            {
                                <span class="badge bg-success fs-6">
                                    Approved
                                </span>
                            }
                            else if (!string.IsNullOrEmpty(Model.Status) && Model.Status.Contains("Rejected"))
                            {
                                <span class="badge bg-danger fs-6">
                                    @Model.Status
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary fs-6">
                                    @Model.Status
                                </span>
                            }
                        </div>
                    </div>

                    <hr />

                    <div class="row mb-3">
                        <div class="col-md-4 text-muted">
                            Nominal Peminjaman
                        </div>
                        <div class="col-md-8 fw-semibold">
                            Rp @Model.Amount.ToString("N0")
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 text-muted">
                            Deskripsi
                        </div>
                        <div class="col-md-8">
                            @if (!string.IsNullOrEmpty(Model.Description))
                            {
                                @Model.Description
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 text-muted">
                            Status
                        </div>
                        <div class="col-md-8">
                            @Model.Status
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 text-muted">
                            Current Approver
                        </div>
                        <div class="col-md-8">
                            @if (!string.IsNullOrEmpty(Model.CurrentApproverRole))
                            {
                                @Model.CurrentApproverRole
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 text-muted">
                            Tanggal Pengajuan
                        </div>
                        <div class="col-md-8">
                            @Model.CreatedAt.ToString("dd MMMM yyyy HH:mm")
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-4 text-muted">
                            Dokumen PDF
                        </div>
                        <div class="col-md-8">
                            @if (!string.IsNullOrEmpty(Model.AttachmentPath))
                            {
                                <a href="@Model.AttachmentPath"
                                   target="_blank"
                                   class="btn btn-outline-primary btn-sm">
                                    View PDF
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">Tidak ada dokumen</span>
                            }
                        </div>
                    </div>

                    <div class="alert alert-light border">
                        <h6 class="fw-bold mb-3">Tracking Approval</h6>

                        <div class="mb-2">
                            <span class="badge bg-secondary">1</span>
                            <span class="ms-2">Staff membuat pengajuan</span>
                        </div>

                        <div class="mb-2">
                            @if (Model.Status == "Pending Manager")
                            {
                                <span class="badge bg-warning text-dark">2</span>
                                <span class="ms-2">Menunggu approval Manager</span>
                            }
                            else
                            {
                                <span class="badge bg-success">2</span>
                                <span class="ms-2">Manager sudah memproses pengajuan</span>
                            }
                        </div>

                        @if (Model.Amount >= 10000000)
                        {
                            <div class="mb-2">
                                @if (Model.Status == "Pending Direktur")
                                {
                                    <span class="badge bg-info text-dark">3</span>
                                    <span class="ms-2">Menunggu approval Direktur</span>
                                }
                                else if (Model.Status == "Approved")
                                {
                                    <span class="badge bg-success">3</span>
                                    <span class="ms-2">Direktur sudah menyetujui pengajuan</span>
                                }
                                else if (!string.IsNullOrEmpty(Model.Status) && Model.Status.Contains("Rejected"))
                                {
                                    <span class="badge bg-danger">3</span>
                                    <span class="ms-2">Pengajuan ditolak</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">3</span>
                                    <span class="ms-2">Menunggu proses berikutnya</span>
                                }
                            </div>
                        }

                        <div>
                            @if (Model.Status == "Approved")
                            {
                                <span class="badge bg-success">Final</span>
                                <span class="ms-2">Pengajuan disetujui</span>
                            }
                            else if (!string.IsNullOrEmpty(Model.Status) && Model.Status.Contains("Rejected"))
                            {
                                <span class="badge bg-danger">Final</span>
                                <span class="ms-2">@Model.Status</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Process</span>
                                <span class="ms-2">Pengajuan masih dalam proses approval</span>
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Kembali
                        </a>

                        <div>
                            @if (User.IsInRole("Manager") && Model.Status == "Pending Manager")
                            {
                                <a asp-action="ApproveManager"
                                   asp-route-id="@Model.Id"
                                   class="btn btn-success">
                                    Approve
                                </a>

                                <a asp-action="Reject"
                                   asp-route-id="@Model.Id"
                                   class="btn btn-danger">
                                    Reject
                                </a>
                            }

                            @if (User.IsInRole("Direktur") && Model.Status == "Pending Direktur")
                            {
                                <a asp-action="ApproveDirektur"
                                   asp-route-id="@Model.Id"
                                   class="btn btn-success">
                                    Approve
                                </a>

                                <a asp-action="Reject"
                                   asp-route-id="@Model.Id"
                                   class="btn btn-danger">
                                    Reject
                                </a>
                            }
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>

</div>