@{
    ViewData["Title"] = "Home";
}

<div class="container mt-5">
    <div class="row align-items-center">
        <div class="col-md-7">
            <h1 class="display-5 fw-bold">
                Loan Approval System
            </h1>

            <p class="lead mt-3">
                Sistem pengajuan peminjaman dengan alur approval berbasis role:
                Staff, Manager, dan Direktur.
            </p>

            <p class="text-muted">
                Staff dapat membuat pengajuan, mengunggah dokumen PDF,
                dan memantau status approval secara real-time.
            </p>

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <a asp-controller="LoanRequests"
                   asp-action="Index"
                   class="btn btn-primary btn-lg mt-3">
                    Masuk ke Loan Request
                </a>
            }
            else
            {
                <a asp-area="Identity"
                   asp-page="/Account/Login"
                   class="btn btn-primary btn-lg mt-3">
                    Login
                </a>

                <a asp-area="Identity"
                   asp-page="/Account/Register"
                   class="btn btn-outline-primary btn-lg mt-3 ms-2">
                    Register
                </a>
            }
        </div>

        <div class="col-md-5 mt-4 mt-md-0">
            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">Approval Flow</h5>

                    <div class="mb-3">
                        <span class="badge bg-secondary">1</span>
                        <span class="ms-2">Staff membuat pengajuan</span>
                    </div>

                    <div class="mb-3">
                        <span class="badge bg-warning text-dark">2</span>
                        <span class="ms-2">Manager melakukan approval</span>
                    </div>

                    <div class="mb-3">
                        <span class="badge bg-info text-dark">3</span>
                        <span class="ms-2">Direktur approve jika nominal ≥ 10 juta</span>
                    </div>

                    <div>
                        <span class="badge bg-success">4</span>
                        <span class="ms-2">Status final Approved / Rejected</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>