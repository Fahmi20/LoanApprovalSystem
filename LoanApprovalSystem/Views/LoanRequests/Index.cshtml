@model IEnumerable<LoanApprovalSystem.Models.LoanRequest>

@{
    ViewData["Title"] = "Loan Requests";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Loan Requests</h2>
            <p class="text-muted mb-0">
                Kelola pengajuan peminjaman dan proses approval berdasarkan role.
            </p>
        </div>

        @if (User.IsInRole("Staff"))
        {
            <a asp-action="Create" class="btn btn-primary">
                + Create New
            </a>
        }
    </div>

    <div class="card shadow border-0 rounded-4">
        <div class="card-body p-4">

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <h5 class="fw-bold">Belum ada pengajuan</h5>
                    <p class="text-muted">
                        Data pengajuan peminjaman belum tersedia.
                    </p>

                    @if (User.IsInRole("Staff"))
                    {
                        <a asp-action="Create" class="btn btn-primary">
                            Buat Pengajuan
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>No. Peminjaman</th>
                                <th>Judul</th>
                                <th>Nominal</th>
                                <th>Deskripsi</th>
                                <th>Tracking</th>
                                <th>Dokumen</th>
                                <th>Dibuat Pada</th>
                                <th class="text-center">Aksi</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold">
                                            @item.LoanNumber
                                        </span>
                                    </td>

                                    <td>
                                        @item.Title
                                    </td>

                                    <td>
                                        Rp @item.Amount.ToString("N0")
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Description))
                                        {
                                            <span>@item.Description</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.Status == "Pending Manager")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Menunggu Manager
                                            </span>
                                        }
                                        else if (item.Status == "Pending Direktur")
                                        {
                                            <span class="badge bg-info text-dark">
                                                Menunggu Direktur
                                            </span>
                                        }
                                        else if (item.Status == "Approved")
                                        {
                                            <span class="badge bg-success">
                                                Approved
                                            </span>
                                        }
                                        else if (!string.IsNullOrEmpty(item.Status) && item.Status.Contains("Rejected"))
                                        {
                                            <span class="badge bg-danger">
                                                @item.Status
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @item.Status
                                            </span>
                                        }

                                        <div class="small text-muted mt-1">
                                            Current: @item.CurrentApproverRole
                                        </div>
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrEmpty(item.AttachmentPath))
                                        {
                                            <a href="@item.AttachmentPath"
                                               target="_blank"
                                               class="btn btn-outline-primary btn-sm">
                                                View PDF
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Tidak ada</span>
                                        }
                                    </td>

                                    <td>
                                        @item.CreatedAt.ToString("dd MMM yyyy HH:mm")
                                    </td>

                                    <td class="text-center">
                                        <div class="d-flex gap-2 justify-content-center flex-wrap">

                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-info btn-sm text-white">
                                                Detail
                                            </a>

                                            @if (User.IsInRole("Manager") && item.Status == "Pending Manager")
                                            {
                                                <a asp-action="ApproveManager"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-success btn-sm">
                                                    Approve
                                                </a>

                                                <a asp-action="Reject"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-danger btn-sm">
                                                    Reject
                                                </a>
                                            }

                                            @if (User.IsInRole("Direktur") && item.Status == "Pending Direktur")
                                            {
                                                <a asp-action="ApproveDirektur"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-success btn-sm">
                                                    Approve
                                                </a>

                                                <a asp-action="Reject"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-danger btn-sm">
                                                    Reject
                                                </a>
                                            }

                                            @if (User.IsInRole("Admin"))
                                            {
                                                <a asp-action="Edit"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-warning btn-sm">
                                                    Edit
                                                </a>

                                                <a asp-action="Delete"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-outline-danger btn-sm">
                                                    Delete
                                                </a>
                                            }

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>
</div>